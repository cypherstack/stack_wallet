#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"

app=""
platform=""
version=""
build_number=""

usage() {
  echo "Usage: $0 --app APP --platform PLATFORM --version VERSION --build-number NUMBER" >&2
  exit 64
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --app) app="${2:-}"; shift 2 ;;
    --platform) platform="${2:-}"; shift 2 ;;
    --version) version="${2:-}"; shift 2 ;;
    --build-number) build_number="${2:-}"; shift 2 ;;
    -h|--help) usage ;;
    *) usage ;;
  esac
done

[ -n "$app" ] && [ -n "$platform" ] && [ -n "$version" ] &&
  [[ "$build_number" =~ ^[0-9]+$ ]] || usage

case "$platform" in
  linux|android)
    [ "$(uname -s):$(uname -m)" = Linux:x86_64 ] || {
      echo "$platform StageX builds require a Linux x86_64 host." >&2
      exit 69
    }
    ;;
  macos|ios)
    [ "$(uname -s)" = Darwin ] || {
      echo "$platform builds require a macOS host with Xcode." >&2
      exit 69
    }
    command -v xcodebuild >/dev/null || {
      echo "Xcode is required for $platform builds." >&2
      exit 69
    }
    ;;
  windows)
    grep -qi microsoft /proc/sys/kernel/osrelease 2>/dev/null || {
      echo "Windows builds require WSL with PowerShell interop." >&2
      exit 69
    }
    command -v powershell.exe >/dev/null || {
      echo "PowerShell interop is unavailable in WSL." >&2
      exit 69
    }
    ;;
  *)
    echo "Unsupported StageX target: $platform" >&2
    exit 64
    ;;
esac

missing_submodules="$(git -C "$PROJECT_ROOT" submodule status --recursive |
  awk '/^-/{print $2}')"
if [ -n "$missing_submodules" ]; then
  echo "Required submodules are not initialized:" >&2
  printf '%s\n' "$missing_submodules" | sed 's/^/  /' >&2
  echo "Run: git submodule update --init --recursive" >&2
  exit 66
fi

export PROJECT_ROOT
case "$platform" in
  linux|android|macos|ios)
    "$SCRIPT_DIR/scripts/fetch-flutter.sh"
    ;;
  windows)
    "$SCRIPT_DIR/scripts/fetch-flutter.sh"
    powershell.exe -NoLogo -NoProfile -NonInteractive \
      -ExecutionPolicy Bypass \
      -File "$(wslpath -w "$SCRIPT_DIR/scripts/fetch-flutter-windows.ps1")" \
      -ProjectRoot "$(wslpath -w "$PROJECT_ROOT")" >/dev/null
    export WINDOWS_FLUTTER_EXE="$PROJECT_ROOT/.flutter-sdk-windows/flutter/bin/flutter.bat"
    export WINDOWS_DART_EXE="$PROJECT_ROOT/.flutter-sdk-windows/flutter/bin/dart.bat"
    export WSLENV="${WSLENV:+${WSLENV}:}WINDOWS_FLUTTER_EXE/p:WINDOWS_DART_EXE/p"
    ;;
esac

export PATH="$PROJECT_ROOT/.flutter-sdk/flutter/bin:$PATH"
export FLUTTER_ROOT="$PROJECT_ROOT/.flutter-sdk/flutter"
export SOURCE_DATE_EPOCH=1
export PERL_HASH_SEED=0
export PERL_PERTURB_KEYS=0
export FLUTTER_SUPPRESS_ANALYTICS=true
export DART_SUPPRESS_ANALYTICS=true
export GOTOOLCHAIN=local
export GOFLAGS="-modcacherw -trimpath -buildvcs=false"

(
  cd "$PROJECT_ROOT/scripts"
  printf 'yes\n' | ./build_app.sh \
    -v "$version" \
    -b "$build_number" \
    -p "$platform" \
    -a "$app" \
    -d -s
)

plugin_version() {
  local plugin="$1"
  local tag
  tag="$(git -C "$plugin" describe --tags --exact-match HEAD 2>/dev/null || true)"
  [[ "$tag" =~ ^[A-Za-z0-9._+-]+$ ]] || tag=dev
  printf '%s' "$tag"
}

epic_dir="$PROJECT_ROOT/crypto_plugins/flutter_libepiccash"
mwc_dir="$PROJECT_ROOT/crypto_plugins/flutter_libmwc"
mkdir -p "$epic_dir/lib" "$mwc_dir/lib"
printf 'String getPluginVersion() => "%s";\n' \
  "$(plugin_version "$epic_dir")" > "$epic_dir/lib/git_versions.dart"
printf 'String getPluginVersion() => "%s";\n' \
  "$(plugin_version "$mwc_dir")" > "$mwc_dir/lib/git_versions.dart"
(
  cd "$PROJECT_ROOT/scripts"
  ./prebuild.sh
)

export STACK_STAGEX_APP="$app"
export STACK_STAGEX_PLATFORM="$platform"
export STACK_STAGEX_VERSION="$version"
export STACK_STAGEX_BUILD_NUMBER="$build_number"
"$SCRIPT_DIR/scripts/build-$platform.sh"
